{% set searchPlayerName = app.request.request.all['search_form']['playerName'] ?? app.request.get('playerName') ?? '' %}
{% set sideMenuItems = [
    {
        label: 'Summary',
        icon: 'fa-house',
        route: 'summary',
        match: ['summary']
    },
    {
        label: 'Runescape News',
        icon: 'fa-square-rss',
        route: 'newsfeed',
        match: ['newsfeed']
    },
    {
        label: 'Activity',
        icon: 'fa-book-open',
        route: 'activities',
        match: ['activities']
    },
    {
        label: 'Drops - Coming Soon',
        icon: 'fa-coins',
        route: 'summary',
        match: ['app_dashboard_drops']
    },
    {
        label: 'Xp Tracker',
        icon: 'fa-chart-simple',
        route: null,
        submenu: true,
        matchPrefix: 'app_xp_tracker',
        children: [
        {
            label: 'Daily',
            route: 'app_xp_tracker_daily',
            match: ['app_xp_tracker_daily']
        },
        {
            label: 'Hourly',
            route: 'app_xp_tracker_hourly',
            match: ['app_xp_tracker_hourly']
        }
    ]
    },
    {
        label: 'Levels - Progress',
        icon: 'fa-chart-simple',
        route: 'app_dashboard_skill_level_progression',
        match: ['app_dashboard_skill_level_progression']
    },
    {
        label: 'Quests',
        icon: 'fa-book',
        route: 'quests',
        match: ['quests']
    },
    {
        label: 'Support with PayPal',
        icon: 'fa-heart',
        external: true,
        url: 'https://www.paypal.com/donate/?hosted_button_id=9PHUY4TXNVKUC'
    },
    {
        label: 'Support with Ko-fi',
        icon: 'fa-coffee',
        external: true,
        url: 'https://ko-fi.com/vincentsch'
    }
] %}


<div class="col-2 pe-1">
    <div class="card card-wrapper">
        <div class="card-body p-0">
            {% if app.request.session.get('currentPlayerName') %}
                <div class="card sub-card current-login-card card-without-footer">
                    <div class="card-header">
                        <div class="avatar-container">
                            <div class="avatar-container-wrap">
                                <img src="https://secure.runescape.com/m=avatar-rs/{{ app.request.session.get('currentPlayerName') }}/chat.png"
                                     alt="{{ app.request.session.get('currentPlayerName') }} avatar"
                                     title="{{ app.request.session.get('currentPlayerName') }} avatar"
                                     class="avatar-img">
                            </div>
                        </div>
                        <p>Current Player</p>
                        <h2>{{ app.request.session.get('currentPlayerName') }}</h2>
                    </div>
                </div>
            {% endif %}

            <div class="list-group overwrite-list-group-border">
                {% for item in sideMenuItems %}
                    {% set isActive = item.match is defined and item.match|filter(v => app.request.attributes.get('_route') == v)|length > 0 %}
                    {% set isPrefixActive = item.matchPrefix is defined and app.request.attributes.get('_route') starts with item.matchPrefix %}

                    {% if item.submenu is defined and item.submenu %}
                        <a class="side-menu-item-link d-flex align-items-center" data-bs-toggle="collapse" href="#xpTrackerMenu" role="button" aria-expanded="{{ isPrefixActive ? 'true' : 'false' }}" aria-controls="xpTrackerMenu">
                            <div class="list-group-item list-group-item-action side-menu-item">
                                <div class="d-flex w-100">
                                    <i class="fa-solid {{ item.icon }} side-menu-icon"></i>
                                    <span class="side-menu-title ms-4">{{ item.label }}</span>
                                    <i class="fa-solid fa-chevron-down ms-auto"></i>
                                </div>
                            </div>
                        </a>
                        <div class="collapse {{ isPrefixActive ? 'show' : '' }}" id="xpTrackerMenu">
                            {% for sub in item.children %}
                                {% set isSubActive = sub.match is defined and sub.match|filter(v => app.request.attributes.get('_route') == v)|length > 0 %}
                                <a href="{{ path(sub.route) }}" class="list-group-item list-group-item-action side-menu-subitem {{ isSubActive ? 'active' : '' }}">
                                    {{ sub.label }}
                                </a>
                            {% endfor %}
                        </div>
                    {% elseif item.external is defined and item.external %}
                        <a href="{{ item.url }}" target="_blank" class="side-menu-item-link donation-item">
                            <div class="list-group-item list-group-item-action side-menu-item">
                                <div class="d-flex w-100">
                                    <i class="fa-solid {{ item.icon }} side-menu-icon"></i>
                                    <span class="side-menu-title ms-4">{{ item.label }}</span>
                                </div>
                            </div>
                        </a>
                    {% else %}
                        <a href="{{ path(item.route) }}" class="side-menu-item-link">
                            <div class="list-group-item list-group-item-action side-menu-item {{ isActive ? 'active' : '' }}">
                                <div class="d-flex w-100">
                                    <i class="fa-solid {{ item.icon }} side-menu-icon"></i>
                                    <span class="side-menu-title ms-4">{{ item.label }}</span>
                                </div>
                            </div>
                        </a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>

